{
  "name": "dorkar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project '*:unit'",
    "test:integration": "vitest run --project '*:integration'",
    "build": "pnpm -r build",
    "infra:up": "docker compose -f infra/docker/compose.yml up -d postgres redis",
    "infra:down": "docker compose -f infra/docker/compose.yml down",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:backend": "node scripts/dev-backend.mjs",
    "e2e:backend": "node scripts/e2e-backend.mjs",
    "e2e:phase2": "node scripts/e2e-phase2.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
