# Copy to secrets.env (git-ignored) and fill in. Shared by every container.
# Generate random values with: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
INTERNAL_API_TOKEN=
PII_HASH_KEY=
MEDIA_SIGNING_KEY=
OTP_PEPPER=
# Identity signing key: pnpm --silent --filter @dorkar/identity-service keys:generate
JWT_KEY_ID=
JWT_PRIVATE_KEY=
# Bearer token for GET /metrics on every service and the gateway (min 32 chars). Leave empty to
# disable /metrics; required by the `observability` compose profile (Prometheus scrapes with it).
METRICS_TOKEN=
