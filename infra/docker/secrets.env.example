# Copy to secrets.env (git-ignored) and fill in. Shared by every container.
# Generate random values with: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
INTERNAL_API_TOKEN=
PII_HASH_KEY=
MEDIA_SIGNING_KEY=
OTP_PEPPER=
# Identity signing key: pnpm --silent --filter @dorkar/identity-service keys:generate
JWT_KEY_ID=
JWT_PRIVATE_KEY=
