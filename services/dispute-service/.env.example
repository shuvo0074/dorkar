NODE_ENV=development
PORT=4016
LOG_LEVEL=info
DATABASE_URL=postgres://svc_dispute:dev_dispute_pw@localhost:5432/dorkar
DATABASE_SCHEMA=dispute
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=
# Hours the respondent has to answer, and before an unassigned case is escalated
DISPUTE_RESPONSE_HOURS=72
DISPUTE_UNASSIGNED_ESCALATION_HOURS=24
# Optional: enables GET /metrics for `Authorization: Bearer <token>` (min 32 chars).
METRICS_TOKEN=
