NODE_ENV=development
PORT=4010
LOG_LEVEL=info
DATABASE_URL=postgres://svc_reputation:dev_reputation_pw@localhost:5432/dorkar
DATABASE_SCHEMA=reputation
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=
# Days after completion during which each party may review the other
REVIEW_WINDOW_DAYS=30
# Most recent reviews per (author, subject) pair that count towards the rating average
REVIEW_PAIR_CAP=3
