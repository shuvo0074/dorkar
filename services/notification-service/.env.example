NODE_ENV=development
PORT=4012
LOG_LEVEL=info
DATABASE_URL=postgres://svc_notification:dev_notification_pw@localhost:5432/dorkar
DATABASE_SCHEMA=notification
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=

# Contact lookup at send time (GET /internal/v1/accounts/:id/contact)
IDENTITY_URL=http://localhost:4001
# Short link base in SMS texts
PUBLIC_BASE_URL=https://dorkar.com.bd
# 'file' is development/staging only; production refuses it
SMS_PROVIDER=file
SMS_FILE_PATH=var/notification-sms.log
SMS_MAX_ATTEMPTS=5
SMS_BATCH_SIZE=20
SMS_DISPATCH_INTERVAL_MS=3000
# Delete read notifications after this many days
NOTIFICATION_RETENTION_DAYS=90
