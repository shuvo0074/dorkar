NODE_ENV=development
PORT=4014
LOG_LEVEL=info
DATABASE_URL=postgres://svc_rental:dev_rental_pw@localhost:5432/dorkar
DATABASE_SCHEMA=rental
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=
# Booking policy
BOOKING_HOLD_MINUTES=15
BOOKING_APPROVAL_HOURS=24
BOOKING_OVERDUE_GRACE_HOURS=2
BOOKING_MAX_ADVANCE_DAYS=180
# Internal dependencies
VERIFICATION_URL=http://localhost:4003
# Optional: enables GET /metrics for `Authorization: Bearer <token>` (min 32 chars).
METRICS_TOKEN=
