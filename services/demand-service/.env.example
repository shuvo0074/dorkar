NODE_ENV=development
PORT=4005
LOG_LEVEL=info
DATABASE_URL=postgres://svc_demand:dev_demand_pw@localhost:5432/dorkar
DATABASE_SCHEMA=demand
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=
# verification-service (policy check at publish; fails closed)
VERIFICATION_URL=http://localhost:4003
# Need policy
NEED_DEFAULT_TTL_DAYS=14
NEED_MAX_TTL_DAYS=60
NEED_MAX_RENEWALS=2
NEED_MAX_OPEN_PER_USER=20
NEED_MAX_OFFERS=50
NEED_EXPIRY_BATCH=500
