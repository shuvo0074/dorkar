NODE_ENV=development
PORT=4015
LOG_LEVEL=info
DATABASE_URL=postgres://svc_lending:dev_lending_pw@localhost:5432/dorkar
DATABASE_SCHEMA=lending
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=
# verification-service (policy checks LEND_ITEM_PUBLISH / LOAN_REQUEST; fails closed)
VERIFICATION_URL=http://localhost:4003
# REQUESTED loans the lender has not answered expire after this
LOAN_REQUEST_TTL_HOURS=48
# Upper bound for an item's max_loan_days
LOAN_MAX_DAYS=60
