# Copy to .env and fill secrets:  pnpm --filter @dorkar/identity-service keys:generate >> .env
NODE_ENV=development
PORT=4001
LOG_LEVEL=info
DATABASE_URL=postgres://svc_identity:dev_identity_pw@localhost:5433/dorkar
DATABASE_SCHEMA=identity
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:5173
# 1 when running behind the gateway (the only way it is reached outside local dev)
TRUST_PROXY=false

# Secrets — generated, never committed
JWT_KEY_ID=
JWT_PRIVATE_KEY=
OTP_PEPPER=
PII_HASH_KEY=

# Dev only: OTP SMS are appended here instead of being sent
SMS_PROVIDER=file
SMS_FILE_PATH=var/dev-sms.log
REFRESH_COOKIE_SECURE=false
# WEBOTP_DOMAIN=localhost
# Optional: enables GET /metrics for `Authorization: Bearer <token>` (min 32 chars).
METRICS_TOKEN=
