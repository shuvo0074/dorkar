NODE_ENV=development
PORT=4017
LOG_LEVEL=info
DATABASE_URL=postgres://svc_messaging:dev_messaging_pw@localhost:5432/dorkar
DATABASE_SCHEMA=messaging
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=
# Messages one sender may send per minute (all conversations)
MESSAGING_SEND_PER_MINUTE=30
# Long-poll ceiling; keep below the gateway's 10s upstream timeout
MESSAGING_LONG_POLL_MAX_SECONDS=8
# Optional: enables GET /metrics for `Authorization: Bearer <token>` (min 32 chars).
METRICS_TOKEN=
