NODE_ENV=development
PORT=4011
LOG_LEVEL=info
DATABASE_URL=postgres://svc_moderation:dev_moderation_pw@localhost:5432/dorkar
DATABASE_SCHEMA=moderation
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=
# Reports one member may file per rolling 24 hours
REPORTS_PER_REPORTER_PER_DAY=20
# Optional: enables GET /metrics for `Authorization: Bearer <token>` (min 32 chars).
METRICS_TOKEN=
