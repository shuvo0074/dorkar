NODE_ENV=development
PORT=4018
LOG_LEVEL=info
DATABASE_URL=postgres://svc_dashboard:dev_dashboard_pw@localhost:5432/dorkar
DATABASE_SCHEMA=dashboard
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=
# Streams to read audit.ActivityRecorded from (comma list of producers)
ACTIVITY_PRODUCERS=identity,profile,verification,catalog,demand,matching,offer,transaction,reputation,moderation,notification,media,bidding,rental,lending,dispute,messaging,dashboard
ACTIVITY_RETENTION_DAYS=365
DASHBOARD_CACHE_SECONDS=30
# Optional: enables GET /metrics for `Authorization: Bearer <token>` (min 32 chars).
METRICS_TOKEN=
