NODE_ENV=development
PORT=4006
LOG_LEVEL=info
DATABASE_URL=postgres://svc_media:dev_media_pw@localhost:5432/dorkar
DATABASE_SCHEMA=media
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=

# local (development only; refused in production) | s3 (AWS, DigitalOcean Spaces, R2, MinIO)
MEDIA_STORAGE=local
# Origin clients use to reach media URLs (the gateway in a full stack)
MEDIA_PUBLIC_BASE_URL=http://localhost:4006
MEDIA_LOCAL_DIR=var/media
# HMAC key for local signed upload/read URLs (min 32 chars)
MEDIA_SIGNING_KEY=
# Decompression-bomb guard for image decoding
MEDIA_MAX_INPUT_PIXELS=40000000

# MEDIA_STORAGE=s3
# S3_ENDPOINT=https://sgp1.digitaloceanspaces.com   (omit for AWS)
# S3_REGION=us-east-1
# S3_BUCKET=dorkar-media
# S3_ACCESS_KEY_ID=          (omit both to use the SDK default credential chain)
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false  (true for MinIO)
# Optional: enables GET /metrics for `Authorization: Bearer <token>` (min 32 chars).
METRICS_TOKEN=
