NODE_ENV=development
PORT=4008
LOG_LEVEL=info
DATABASE_URL=postgres://svc_offer:dev_offer_pw@localhost:5432/dorkar
DATABASE_SCHEMA=offer
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=
# Offer policy
OFFER_DEFAULT_TTL_HOURS=72
OFFER_MAX_TTL_DAYS=14
OFFER_MAX_ROUNDS=5
# Internal dependencies
VERIFICATION_URL=http://localhost:4003
PROFILE_URL=http://localhost:4002
# Optional: enables GET /metrics for `Authorization: Bearer <token>` (min 32 chars).
METRICS_TOKEN=
