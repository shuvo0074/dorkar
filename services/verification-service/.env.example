NODE_ENV=development
PORT=4003
LOG_LEVEL=info
DATABASE_URL=postgres://svc_verification:dev_verification_pw@localhost:5432/dorkar
DATABASE_SCHEMA=verification
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# Keys the NID fingerprint (duplicate detection) and IP hashes. Rotating it orphans fingerprints.
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=
# NID provider: manual (admin review queue). Real providers plug in behind the NidProvider port.
NID_PROVIDER=manual
# Optional: enables GET /metrics for `Authorization: Bearer <token>` (min 32 chars).
METRICS_TOKEN=
