NODE_ENV=development
PORT=4009
LOG_LEVEL=info
DATABASE_URL=postgres://svc_transaction:dev_transaction_pw@localhost:5432/dorkar
DATABASE_SCHEMA=txn
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4001/.well-known/jwks.json
TRUST_PROXY=1
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
# node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
PII_HASH_KEY=
# Lifecycle windows
TRANSACTION_CONFIRM_TTL_HOURS=48
TRANSACTION_AUTO_COMPLETE_DAYS=3
TRANSACTION_DISPUTE_WINDOW_DAYS=3
# RENT/BORROW: owner's damage-claim window after the return, then auto-complete
TRANSACTION_RETURN_COMPLETE_HOURS=24
# Optional: enables GET /metrics for `Authorization: Bearer <token>` (min 32 chars).
METRICS_TOKEN=
